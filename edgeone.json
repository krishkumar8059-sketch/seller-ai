{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": ".",
  "cloudFunctions": {
    "nodejs": {
      "runtime": "nodejs18",
      "maxDuration": 30
    }
  },
  "caches": [
    {
      "source": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    }
  ]
}
